APP_NAME="Best Play"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Slack: Incoming Webhook (https://api.slack.com/messaging/webhooks)
# SLACK_ENABLED=true  → ativa exception reporter + canal de log automático
# SLACK_ENABLED=false → desativa tudo
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false
# Opcional: sobrescrever o nível mínimo do canal de log (padrão: error)
# LOG_SLACK_LEVEL=error
# LOG_SLACK_USERNAME="${APP_NAME}"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Production: prefer redis for SESSION_DRIVER, CACHE_STORE and QUEUE_CONNECTION; every SPA request reads
# and writes the session, and settings/navigation reads go through the cache.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
VITE_REVERB_ENABLED=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend mail transport
# Set MAIL_MAILER=resend and configure RESEND_API_KEY in production.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Comma-separated SNS topic ARNs accepted by the SES webhook.
SES_ALLOWED_TOPIC_ARNS=

# Configure this token as X-Postmark-Webhook-Token in Postmark HttpHeaders.
POSTMARK_WEBHOOK_TOKEN=

# Email module runtime switches
EMAIL_ENABLED=true
EMAIL_AUTH_ENABLED=true
EMAIL_EXPORT_ENABLED=true
EMAIL_NOTIFICATION_ENABLED=true
EMAIL_SYSTEM_ENABLED=true
# EMAIL_TO_OVERRIDE=dev@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# Pulse records every request into the database by default. In production, buffer through Redis
# (then run `php artisan pulse:work`) and sample, or set PULSE_ENABLED=false.
#PULSE_ENABLED=true
#PULSE_INGEST_DRIVER=redis
#PULSE_USER_REQUESTS_SAMPLE_RATE=0.1
#PULSE_CACHE_INTERACTIONS_SAMPLE_RATE=0.1

TELESCOPE_ENABLED=true
#TELESCOPE_DOMAIN=
#TELESCOPE_PATH=
#TELESCOPE_DRIVER=
#TELESCOPE_QUEUE_CONNECTION=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# DEBUGBAR_ENABLED=false

# Marca (config/branding.php). Hue em graus oklch, 0 a 360; padrao 215.
BRAND_NAME="Best Play"
BRAND_SHORT_NAME=BP
BRAND_HUE=12
# Logos de arquivo (caminho em public/) precisam ter cores proprias: <img> nao herda a cor do tema.
# BRAND_LOGO_MARK=brand/minha-marca.svg
# BRAND_LOGO_LIGHT=
# BRAND_LOGO_DARK=

# Spotify Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_BASE_URL=https://api.spotify.com/v1
SPOTIFY_AUTH_URL=https://accounts.spotify.com
SPOTIFY_TIMEOUT=10
SPOTIFY_CONNECT_TIMEOUT=5
